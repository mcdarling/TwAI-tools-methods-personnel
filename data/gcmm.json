  "extra_requirements": [
    {
      "id": "hy.surrogate_error",
      "element": "US",
      "level": 1,
      "label": "Surrogate / learned-component error characterized and propagated"
    },
    {
      "id": "hy.coupling",
      "element": "IV",
      "level": 1,
      "label": "Verification of simulator-ML coupling"
    },
    {
      "id": "hy.physics_constraints",
      "element": "MF",
      "level": 1,
      "label": "Evidence that physical constraints are satisfied"
    },
    {
      "id": "gen.output_validity",
      "element": "VAL",
      "level": 1,
      "label": "Validity of generated content against reference reality"
    },
    {
      "id": "gen.provenance",
      "element": "IV",
      "level": 1,
      "label": "Provenance and verification of third-party model weights and training data"
    },
    {
      "id": "un.structure_validity",
      "element": "VAL",
      "level": 1,
      "label": "Validity and stability of discovered structure"
    },
    {
      "id": "rl.env_fidelity",
      "element": "RF",
      "level": 1,
      "label": "Fidelity of the training environment to the deployment environment"
    }
  ],
  "rules": [
    {
      "id": "causal-claim",
      "provisional": true,
      "when": {
        "claim": [
          "intervention",
          "counterfactual"
        ]
      },
      "add": [
        "rf.structural",
        "rf.confounding",
        "mf.mechanism"
      ],
      "flag": "You plan to use the model to reason about interventions or counterfactuals. A model learned only from observational data cannot support causal claims without explicit structural assumptions (GCMM paper, causal ladder discussion), so structural evidence is required whatever the consequence level.",
      "reason": "the model will support causal claims"
    },
    {
      "id": "shift-expected",
      "provisional": true,
      "when": {
        "shift_expected": [
          true
        ]
      },
      "add": [
        "rf.shift_analysis",
        "val.shift_aware"
      ],
      "flag": "You expect the operating conditions to shift after training, so shift analysis and shift-aware validation are required whatever the consequence level.",
      "reason": "operating conditions are expected to shift"
    },
    {
      "id": "operational-use",
      "provisional": true,
      "when": {
        "deployment": [
          "operational",
          "autonomous"
        ]
      },
      "add": [
        "val.monitoring",
        "mf.drift"
      ],
      "flag": "The model will run operationally, so post-deployment monitoring and drift detection are required.",
      "reason": "the model will run operationally"
    },
    {
      "id": "autonomous-use",
      "provisional": true,
      "when": {
        "deployment": [
          "autonomous"
        ]
      },
      "add": [
        "us.decision_coupled"
      ],
      "flag": "The model acts without a human in the loop, so it needs defined abstention or escalation behavior.",
      "reason": "the model acts without a human in the loop"
    }
  ]
}
