{
  "source": "Nichol & Darling, 'From Incredible Claims to Credible AI: Evidence-Backed Maturity Profiles for Risk-Informed AI Assurance' (AAAI-26). Tables 1-3.",
  "elements": [
    {
      "id": "RF",
      "name": "Representational Fidelity",
      "question": "Does the model include the variables, scales, operating conditions, measurements, and use-time information needed for the target?"
    },
    {
      "id": "MF",
      "name": "Mechanistic / Functional Fidelity",
      "question": "Do the modeled or learned relationships reflect relevant mechanisms, constraints, invariances, causal structure, or functional dependencies?"
    },
    {
      "id": "IV",
      "name": "Implementation Verification",
      "question": "Does the implemented system correctly realize the specified model, data pipeline, features, configuration, training, evaluation, and deployment logic?"
    },
    {
      "id": "EV",
      "name": "Execution Verification",
      "question": "Are reported results free from material numerical, stochastic, procedural, sampling, workflow, or reproducibility errors?"
    },
    {
      "id": "VAL",
      "name": "Validation",
      "question": "Does evidence compare model behavior with relevant reality across intended operating conditions, populations, workflows, and shifts?"
    },
    {
      "id": "US",
      "name": "Uncertainty & Sensitivity Characterization",
      "question": "Are uncertainties, sensitivities, brittle operating conditions, calibration limits, and confidence claims characterized and communicated?"
    }
  ],
  "levels": [
    {
      "level": 0,
      "name": "Ad hoc / unsupported",
      "review": "Judgment alone",
      "review_role": null
    },
    {
      "level": 1,
      "name": "Documented / justified",
      "review": "Assessed by developers only",
      "review_role": null
    },
    {
      "level": 2,
      "name": "Systematic / evidence-backed",
      "review": "Some peer review",
      "review_role": "peer_reviewer"
    },
    {
      "level": 3,
      "name": "Operationally mature / structurally justified",
      "review": "Independent peer review",
      "review_role": "independent_review"
    }
  ],
  "consequence": {
    "low": {
      "label": "Low consequence, low impact",
      "target": 0
    },
    "moderate": {
      "label": "Moderate consequence, moderate impact",
      "target": 1
    },
    "high": {
      "label": "High consequence, high impact",
      "target": 2
    },
    "critical": {
      "label": "High consequence, critical decision impact",
      "target": 3
    }
  },
  "paradigms": [
    {
      "id": "pde-sbes",
      "name": "Explicit mechanistic model (PDE / simulation)",
      "when": {
        "representation": [
          "mechanistic"
        ]
      },
      "framework": "external",
      "framework_note": "PCMM (SAND2007-5948) is the established credibility framework for this paradigm. Its methods are not yet in this catalog, so no requirements are generated.",
      "rubric": null
    },
    {
      "id": "sciml-hybrid",
      "name": "Scientific ML / hybrid physics-data model",
      "when_any": [
        {
          "representation": [
            "hybrid"
          ]
        },
        {
          "algorithm": [
            "pinn"
          ]
        }
      ],
      "framework": "gap",
      "framework_note": "GCMM names SciML and hybrid models but has no instantiated rubric for them yet. The supervised-ML rubric is used as a baseline for the learned component, plus the paradigm-specific evidence needs the paper lists (surrogate error, simulator coupling, physical constraints).",
      "rubric": "supervised-ml",
      "extra_requirements": [
        "hy.surrogate_error",
        "hy.coupling",
        "hy.physics_constraints"
      ]
    },
    {
      "id": "generative",
      "name": "Generative / foundation model",
      "when_any": [
        {
          "learning": [
            "generative"
          ]
        },
        {
          "algorithm": [
            "foundation"
          ]
        }
      ],
      "framework": "gap",
      "framework_note": "No GCMM instantiation exists for generative or foundation models. The supervised-ML rubric is used as a partial baseline.",
      "rubric": "supervised-ml",
      "extra_requirements": [
        "gen.output_validity",
        "gen.provenance"
      ]
    },
    {
      "id": "unsupervised",
      "name": "Unsupervised learning",
      "when": {
        "learning": [
          "unsupervised"
        ]
      },
      "framework": "gap",
      "framework_note": "No GCMM instantiation exists for unsupervised learning. The supervised-ML rubric is used as a partial baseline; label-based validation does not apply directly.",
      "rubric": "supervised-ml",
      "extra_requirements": [
        "un.structure_validity"
      ]
    },
    {
      "id": "rl",
      "name": "Reinforcement learning",
      "when": {
        "learning": [
          "reinforcement"
        ]
      },
      "framework": "gap",
      "framework_note": "No GCMM instantiation exists for reinforcement learning. The supervised-ML rubric is used as a partial baseline.",
      "rubric": "supervised-ml",
      "extra_requirements": [
        "rl.env_fidelity"
      ]
    },
    {
      "id": "supervised-ml",
      "name": "Supervised machine learning",
      "when": {
        "learning": [
          "supervised"
        ]
      },
      "framework": "instantiated",
      "framework_note": "Rubric from GCMM Table 3 (supervised ML).",
      "rubric": "supervised-ml"
    }
  ],
  "rubrics": {
